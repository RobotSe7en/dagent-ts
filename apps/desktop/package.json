{
  "name": "@dagent/work",
  "productName": "DagentWork",
  "version": "0.9.5",
  "description": "Private Electron application for the local-first DagentWork desktop",
  "license": "Apache-2.0",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm typecheck && electron-forge package",
    "clean": "rm -rf .vite out",
    "dev": "electron-forge start",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "stage:platform": "node scripts/stage-platform.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "dagent-ai": "workspace:*",
    "dagent-ai-app": "workspace:*",
    "diff": "9.0.0",
    "lucide-react": "1.22.0",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@reforged/maker-appimage": "5.2.0",
    "@types/diff": "8.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "43.2.0",
    "vite": "8.1.5"
  }
}
