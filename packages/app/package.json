{
  "name": "dagent-ai-app",
  "version": "0.9.5",
  "description": "Local API, CLI, and Web UI host for dagent-ai",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "dagent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean && rm -rf dist",
    "dev": "node --experimental-strip-types --watch src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/static": "8.3.0",
    "better-sqlite3": "13.0.1",
    "dagent-ai": "workspace:*",
    "fastify": "5.10.0",
    "kysely": "0.29.4",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
